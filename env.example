# restash server settings. Copy this file to .env next to compose.yaml
# and change what you need. See the README for every setting.

# The site's address, used in links.
RESTASH_PUBLIC_URL=https://restash.example.com

# Deleted backup files stay in storage/trash this many days.
RESTASH_TRASH_DAYS=30

# Prometheus metrics (per PC: online, last backup, size, problems).
# Keep this off the public site: in compose.yaml only the monitoring
# network reaches it.
RESTASH_METRICS_LISTEN=:9464

# Alerts to ntfy are off unless a server is set. People pick their own
# topic on it.
# RESTASH_NTFY_SERVER=https://ntfy.sh

# Invite emails are off unless an SMTP server is set; then restash emails
# invite links instead of you sending them yourself.
# RESTASH_SMTP_HOST=smtp.example.com:587
# RESTASH_SMTP_FROM="restash <no-reply@example.com>"
# RESTASH_SMTP_USERNAME=
# RESTASH_SMTP_PASSWORD=
# starttls (default), tls (port 465), or none for a relay on a private
# network.
# RESTASH_SMTP_TLS=starttls
